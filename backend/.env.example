# Copy to .env and fill in.
JWT_SECRET=change-me-to-a-long-random-string
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
ANTHROPIC_API_KEY=sk-ant-...
FRONTEND_ORIGIN=http://localhost:3000

# Local dev conveniences
DEV_AUTH=true            # adds a "dev login" button; turn off in production
OCR_BACKEND=vision       # vision | none  (vision needs GOOGLE_APPLICATION_CREDENTIALS)
STORAGE_BACKEND=local    # local | gcs
# GCS_BUCKET=my-bucket
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# FAKE_MODELS=true       # skip SBERT/CLIP downloads (hash embeddings, poor quality)

# Cost guards - hard caps checked before every paid call (see /usage)
MONTHLY_BUDGET_USD=5        # total Claude + Vision spend per calendar month, all users
USER_DAILY_BUDGET_USD=1     # per user per day
OCR_MONTHLY_LIMIT=900       # Vision images/month (first 1,000 are free)
# CLAUDE_MODEL=claude-sonnet-5-5  # default; claude-haiku-5-5 is ~20x cheaper

# Gemini query parsing (optional; falls back to free rules)
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash-lite
